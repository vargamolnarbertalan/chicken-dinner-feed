# Normalise to LF in the repository, check out per the rules below.
* text=auto eol=lf

# Windows batch files must keep CRLF or cmd.exe mis-parses multi-line blocks.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.svg text
*.pdf binary
*.zip binary
*.woff binary
*.woff2 binary
*.ttf binary

# Keep generated lockfiles out of diff review noise.
package-lock.json linguist-generated=true -diff
