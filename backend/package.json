{
  "name": "@cdf/backend",
  "version": "1.0.0",
  "private": true,
  "description": "Fastify service: ingests PCOB match data, holds live state, serves the admin API and the built frontend.",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@cdf/shared": "*",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.3",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/websocket": "^11.3.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.3",
    "fastify-type-provider-zod": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.11",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  }
}
