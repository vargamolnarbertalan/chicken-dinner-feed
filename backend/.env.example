# Copy this file to `.env` and adjust as needed. `.env` is git-ignored.
# Every value here has a working default — the app starts with no .env at all.

# --- HTTP server -------------------------------------------------------------

# Port the backend listens on. This is also the port used by overlay browser
# sources and by the admin UI, since one process serves everything (ADR-0002).
PORT=4317

# Interface to bind to. Keep this on loopback: the admin has no authentication,
# and loopback binding is what keeps it off the network (ADR-0008).
# Change it only if you understand that it exposes an unauthenticated admin UI.
HOST=127.0.0.1

# --- Runtime -----------------------------------------------------------------

# development | production
NODE_ENV=development

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- Paths -------------------------------------------------------------------

# Where persisted configuration lives (ADR-0004). Relative paths resolve from
# the backend package root. Back this directory up before upgrading a bundle.
DATA_DIR=./data

# Directory of the built frontend, served by the backend in production.
# Defaults to ../frontend/dist in a checkout and to ./public inside a release
# bundle; set explicitly only if your layout differs.
# STATIC_DIR=

# --- PCOB ingestion ----------------------------------------------------------

# Which ingestion adapter to use (ADR-0006).
#   mock — replays scripted match data, needs no game running
#   pcob — the real PCOB API adapter
# NOTE: `pcob` is not implemented yet. The transport is known (see below), but
# the live endpoint and the JSON payload shape are not; see
# specs/PCOB-FINDINGS.md "Open questions".
INGEST_SOURCE=mock

# Base URL of the PCOB API. It is an HTTP server on the observer PC, started by
# ObToolsNew\launch.bat, and it must have "API Enable" ticked in the PCOB client.
# Port 10086 is what the client documentation uses; it is not documented as
# configurable, which is exactly why this is a setting (ADR-0010).
PCOB_BASE_URL=http://127.0.0.1:10086

# How often to poll, in milliseconds. Upstream refreshes every ~2000 ms, so
# polling faster gains nothing; 1000 ms bounds staleness at about one upstream
# tick without beating against it.
PCOB_POLL_INTERVAL_MS=1000

# Per-request timeout in milliseconds. Must stay below the poll interval so a
# hung request cannot queue up behind the next one.
PCOB_REQUEST_TIMEOUT_MS=800
