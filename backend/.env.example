# Copy this file to `.env` and adjust as needed. `.env` is git-ignored.
# Every value here has a working default — the app starts with no .env at all.

# --- HTTP server -------------------------------------------------------------

# Port the backend listens on. This is also the port used by overlay browser
# sources and by the admin UI, since one process serves everything (ADR-0002).
PORT=4317

# Interface to bind to. Keep this on loopback: the admin has no authentication,
# and loopback binding is what keeps it off the network (ADR-0008).
#
# Change it to 0.0.0.0 only if Bitfocus Companion (or another controller) runs on
# a DIFFERENT machine and has to reach the overlay control endpoints. Doing so
# also exposes the admin UI to everyone on the network. The app logs a warning at
# startup when this is not loopback.
HOST=127.0.0.1

# Optional shared secret for the overlay control endpoints (ADR-0012). Empty
# means no check, which is correct while HOST stays on loopback.
# When set, Companion must send it as ?token=... or an X-Control-Token header.
# This is a speed bump for a venue LAN, NOT authentication, and it does not
# protect the admin UI.
CONTROL_TOKEN=

# --- Runtime -----------------------------------------------------------------

# development | production
NODE_ENV=development

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- Paths -------------------------------------------------------------------

# Where persisted configuration lives (ADR-0004). Relative paths resolve from
# the backend package root. Back this directory up before upgrading a bundle.
DATA_DIR=./data

# Directory of the built frontend, served by the backend in production.
# Defaults to ../frontend/dist in a checkout and to ./public inside a release
# bundle; set explicitly only if your layout differs.
# STATIC_DIR=

# --- PCOB ingestion ----------------------------------------------------------

# Which ingestion adapter to use (ADR-0006).
#   mock — simulates a match, needs no game running
#   pcob — polls the real PCOB API
#
# `pcob` needs the PCOB client running with "API Enable" ticked and
# ObToolsNew\launch.bat open. Until a match has been captured and checked
# against specs/PCOB-API.md §8, prefer `mock` for anything you are going to put
# on air: the adapter degrades a field it cannot read to a logged warning, so a
# mismatch is survivable, but it has not yet been seen against real game data.
INGEST_SOURCE=mock

# Base URL of the PCOB API — a full origin, not just a port.
#
# The server binds every interface (ob.js calls listen(10086) with no host), so
# it is reachable across the venue LAN. If this app runs on a different machine
# from the observer, put the OB PC's address here (ADR-0010).
PCOB_BASE_URL=http://127.0.0.1:10086

# How often to poll, in milliseconds. Upstream refreshes every ~2000 ms, so
# polling faster gains nothing; 1000 ms bounds staleness at about one upstream
# tick without beating against it.
PCOB_POLL_INTERVAL_MS=1000

# Per-request timeout in milliseconds.
#
# This is not optional tuning. ob.js answers an unknown route by logging and
# returning WITHOUT ending the response, so a request can hang forever rather
# than failing. Overlapping polls are prevented structurally, so raising this is
# safe — do so if the OB PC is heavily loaded and you see the connection
# indicator flapping.
PCOB_REQUEST_TIMEOUT_MS=800
